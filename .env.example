DATABASE_URL=postgresql+asyncpg://migrationguard:migrationguard@localhost:5432/migrationguard
REDIS_URL=redis://localhost:6379/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-48-byte-secret
JWT_EXPIRE_MINUTES=60
APP_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000
# Clerk: exact issuer from your Clerk dashboard; never a URL supplied by a token.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=["http://localhost:3000"]
# Set if your Clerk token template includes an audience.
# CLERK_AUDIENCE=migrationguard
# Frontend keys from your own Clerk instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
MIGRATIONGUARD_ENABLE_EXECUTION=false
OPENREWRITE_ENABLED=false
# Optional: choose prewarmed images and repository cache for offline verification.
# MAVEN_IMAGE_TEMPLATE=migrationguard-fixture-java{java_version}:local
# MAVEN_REPOSITORY_PATH=/opt/maven-repository
MAVEN_OFFLINE=false
# DOCKER_EXECUTABLE=C:/Program Files/Docker/Docker/resources/bin/docker.exe
# Host shell commands are opt-in and require an isolated worker host.
WORKSPACE_EXECUTION_ENABLED=false
TERMINAL_TIMEOUT_SECONDS=300
AGENT_MAX_RETRIES=3
CAMBER_MCP_ACCESS_TOKEN=
CAMBER_CHAT_AGENT=
CAMBER_FIXER_AGENT=
SENTRY_DSN=
AZURE_ENABLED=false
AZURE_SUBSCRIPTION_ID=
# Required when Azure is enabled: a remote-reachable HTTPS API address.
BACKEND_PUBLIC_URL=
# Optional per-project remote workspace mapping (one deployed container per project).
# AZURE_WORKSPACES={"project-uuid":{"url":"https://workspace.example.com","token":"replace-with-workspace-token"}}
